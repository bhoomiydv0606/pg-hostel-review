rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users — user can read/write their own doc, admin can manage all
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']));
    }

    // PGs — anyone signed in can create, owners can edit their own, admin manages all
    match /pgs/{pgId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive', 'avgRating', 'reviewCount']));
      allow delete: if isAdmin();
    }

    // Reviews — signed in users can create/read, owner of review can delete, admin can manage
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // PG Photos — everyone can read, signed in can create, admin can moderate
    match /pg_photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Analytics Events — signed in users can create, admin can read
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // Visit Requests — signed in users can create, admin can read
    match /visitRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // Reports — signed in users can create, admin can read/manage
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}
